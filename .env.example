# AI Business Architect - Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Application Environment (development | production | test)
APP_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security - Cryptographic secret key for session signatures and CSRF protection
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_for_production_use

# Session Configuration
SESSION_COOKIE_NAME=aba_session
SESSION_MAX_AGE_SECONDS=604800
# Must be true in production; false for local HTTP development:
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax


# Database Configuration (PostgreSQL with psycopg 3 driver)
# Render format: postgresql+psycopg://user:password@host:port/dbname
# Local dev: postgresql+psycopg://postgres:postgres@localhost:5432/ai_business_architect
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_business_architect

# Local Docker Compose Database Credentials (Development Only)
# Production on Render uses managed PostgreSQL via DATABASE_URL; do not configure these in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_DB=ai_business_architect

# AI Provider Configuration (Google Gemini)
# Obtain your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# CORS / Origin Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# External Market Research
# Uses DuckDuckGo search by default (no separate API key required).
# Safe external web search with SSRF protection and live source attribution.
RESEARCH_PROVIDER=duckduckgo

# Observability
LOG_LEVEL=INFO

# Public Site URL & Canonical SEO Configuration
# Configure with your actual Render deployment URL or leave blank during local dev.
# Never use placeholder domains.
# Production on Render:
# PUBLIC_SITE_URL=https://<your-service>.onrender.com
# VITE_PUBLIC_SITE_URL=https://<your-service>.onrender.com
# Local development:
# PUBLIC_SITE_URL=http://localhost:8000
# VITE_PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_SITE_URL=
VITE_PUBLIC_SITE_URL=
